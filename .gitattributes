# Held-out files are hashed byte for byte (docs/eval/heldout-v1.lock); keep LF on every OS.
docs/eval/heldout-v1.yaml text eol=lf
docs/eval/heldout-v1.lock text eol=lf
# The relevance dev set is also hashed byte for byte.
tests/acceptance/answer_relevance_dev_v1.yaml text eol=lf
tests/acceptance/answer_relevance_dev_v1.lock text eol=lf
# Held-out v2 questions are hashed byte for byte too.
docs/eval/heldout-v2-questions.yaml text eol=lf
docs/eval/heldout-v2-questions.lock text eol=lf
# The false-refusal dev set is hashed byte for byte too.
tests/acceptance/false_refusal_dev_v1.yaml text eol=lf
tests/acceptance/false_refusal_dev_v1.lock text eol=lf
# Eval data for CI: PDFs are hashed byte for byte (eval-data/corpus-v2/SHA256SUMS).
eval-data/**/*.pdf binary
eval-data/**/*.json text eol=lf
eval-data/corpus-v2/SHA256SUMS text eol=lf
