# Production example values. Copy to a private .env.production file or inject through
# your deployment secret manager. Do not put real secrets in this example file.

APP_IMAGE=enterprise-ai-knowledge-assistant-backend:prod
APP_ENV=production
APP_DEBUG=false
DEBUG=false
API_DOCS_ENABLED=false

SECRET_KEY=replace-with-production-secret-key
SECRET_KEY_FILE=

POSTGRES_DB=enterprise_ai
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-production-postgres-password
DATABASE_URL=postgresql+asyncpg://app_user:replace-with-production-postgres-password@postgres:5432/enterprise_ai
DATABASE_URL_FILE=

REDIS_URL=redis://redis:6379/0
REDIS_URL_FILE=
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_BROKER_URL_FILE=
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_RESULT_BACKEND_FILE=
CELERY_WORKER_CONCURRENCY=2

LOCAL_STORAGE_PATH=/app/data/uploads
EMBEDDING_MODEL_CACHE_PATH=/app/data/models
HF_HOME=/app/data/models/huggingface
SENTENCE_TRANSFORMERS_HOME=/app/data/models/sentence-transformers

CORS_ALLOWED_ORIGINS=https://assistant.example.com
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=assistant.example.com,localhost,127.0.0.1
FORWARDED_ALLOW_IPS=*
MAX_REQUEST_BODY_BYTES=26214400

OBSERVABILITY_ENABLED=true
REQUEST_LOG_ENABLED=true
METRICS_ENABLED=true
METRICS_INCLUDE_SUBSYSTEM_HEALTH=true
TRACING_HOOKS_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
TRACEPARENT_HEADER=traceparent

LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_KEY_FILE=

WEB_SEARCH_ENABLED=false
WEB_SEARCH_ALLOW_EXTERNAL=false
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_BING_API_KEY=
WEB_SEARCH_BING_API_KEY_FILE=
WEB_SEARCH_GOOGLE_API_KEY=
WEB_SEARCH_GOOGLE_API_KEY_FILE=
WEB_SEARCH_GOOGLE_CX=

PROXY_HTTP_PORT=8080
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password
