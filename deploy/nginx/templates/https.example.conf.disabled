# Example TLS server block for production certificate mounting.
# This file is intentionally disabled by extension and is not loaded by Nginx.
# Mount real certificates at runtime and copy this to a .conf.template file outside source
# control (the entrypoint renders *.conf.template into conf.d/, see default.conf.template).
#
# server {
#     listen 8443 ssl http2;
#     server_name ${PROXY_SERVER_NAMES};
#     # TC-SEC-08: other names need their own default, e.g.
#     # server { listen 8443 ssl default_server; ssl_reject_handshake on; }
#     absolute_redirect off;
#
#     ssl_certificate /etc/nginx/certs/fullchain.pem;
#     ssl_certificate_key /etc/nginx/certs/privkey.pem;
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_prefer_server_ciphers off;
#
#     client_max_body_size 25m;
#     proxy_read_timeout 130s;
#
#     add_header Strict-Transport-Security "max-age=31536000" always;
#     # ... the location blocks of default.conf.template
# }
