# A template: at start the nginx entrypoint writes conf.d/default.conf from it (replacing the
# image's default server), filling in only PROXY_SERVER_NAMES (NGINX_ENVSUBST_FILTER in
# compose.prod.yaml).

upstream enterprise_ai_api {
    server api:8000;
    keepalive 32;
}

# TC-SEC-08: a Host that is not one of the names below gets no answer at all (444), so nothing
# is ever built from a forged Host.
server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8080;
    # PROXY_SERVER_NAMES (.env.production): the deployment's host names, space-separated; each one
    # must also be in TRUSTED_HOSTS. localhost and 127.0.0.1 serve the healthcheck.
    server_name localhost 127.0.0.1 ${PROXY_SERVER_NAMES};
    absolute_redirect off;  # TC-SEC-08: a redirect names the path only, never a host or port

    client_max_body_size 25m;
    proxy_connect_timeout 10s;
    proxy_send_timeout 130s;
    proxy_read_timeout 130s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /metrics {
        return 404;
    }

    location ~ ^/api/v1/chat/sessions/[^/]+/messages/stream$ {
        proxy_pass http://enterprise_ai_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $proxy_request_id;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
    }

    location / {
        proxy_pass http://enterprise_ai_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $proxy_request_id;
        proxy_set_header Connection "";
    }
}
